# Konfigurasi engine ragai.
#
# Hanya variabel di berkas ini yang dibaca engine. Milik aplikasi induk
# (kunci Django, basis data, SMTP, kunci API konsumen) tinggal di berkas
# lingkungan aplikasi itu sendiri dan tidak disentuh engine.
#
# Aplikasi induk juga boleh menyuntikkan nilai-nilai ini lewat
# `runtime.configure(config={...})`, misalnya bila diambil dari secret manager
# alih-alih variabel lingkungan.

# --- Penyedia LLM -----------------------------------------------------------
# Minimal satu kunci harus terisi, jika tidak engine hanya dapat menjawab
# secara ekstraktif tanpa penyusunan kalimat.
OPENAI_API_KEY=
# Kosongkan untuk memakai seluruh penyedia berkredensial dengan fallback.
# Isi ("openai", "groq") untuk mengunci ke satu penyedia.
LLM_PROVIDER=openai
LLM_MODEL=
# Dipakai penyedia yang berbicara protokol OpenAI di alamat lain.
LLM_BASE_URL=
LLM_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Setel 0 untuk mematikan pemanggilan LLM; engine tetap berjalan.
INTELLIGENCE_LLM_ENABLED=1

# --- Embedding --------------------------------------------------------------
# Tanpa embedding, jurnal hanya terjangkau lewat kecocokan kata kunci dan
# lantai kemiripan makna tidak dapat diterapkan.
EMBEDDINGS_ENABLED=1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# --- Sumber literatur -------------------------------------------------------
# Alamat surel untuk "polite pool" Crossref. Boleh kosong, tetapi mengisinya
# memberi kuota permintaan yang lebih longgar.
CROSSREF_MAILTO=

# --- Pelengkapan basis pengetahuan ---
# Setel 0 untuk mematikan pencarian jurnal otomatis ke Crossref. Dipakai
# pengujian agar tidak menembak jaringan.
KNOWLEDGE_ACQUISITION_ENABLED=1

# --- Verifikasi tautan ------------------------------------------------------
# Setel 0 hanya untuk pengujian luring: mematikannya berarti DOI tidak lagi
# diperiksa ke registry, dan tautan mati bisa lolos ke jawaban.
EVIDENCE_LINK_CHECK_ENABLED=1

# --- Penilaian bukti --------------------------------------------------------
# Bobot komponen skor. Hanya dapat diisi lewat `runtime.configure(config=)`
# karena berupa dict, bukan lewat variabel lingkungan.
# EVIDENCE_SCORE_WEIGHTS
